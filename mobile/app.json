{
  "expo": {
    "name": "Atlas",
    "slug": "atlas-mobile",
    "scheme": "atlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6fbf4"
    },
    "ios": {
      "bundleIdentifier": "com.team3.atlas",
      "supportsTablet": true
    },
    "android": {
      "package": "com.team3.atlas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6fbf4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atlas uses your location to reveal nearby habitat cells."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atlas uses your photos to register ecological observations."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "../BookkGothic_Light.ttf",
            "../BookkGothic_Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "BookkGothic-Light",
                "fontDefinitions": [
                  {
                    "path": "../BookkGothic_Light.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "BookkGothic-Bold",
                "fontDefinitions": [
                  {
                    "path": "../BookkGothic_Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": [
            "../BookkGothic_Light.ttf",
            "../BookkGothic_Bold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Atlas uses your camera to capture ecological observations.",
          "microphonePermission": "Atlas uses your microphone for observation recordings.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Atlas uses your microphone for observation recordings."
        }
      ],
      "expo-web-browser"
    ]
  }
}
